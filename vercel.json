{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.{jpg,jpeg,png,gif,svg,ico,woff2,woff}",
      "use": "@vercel/static"
    },
    {
      "src": "api/webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/create-payment.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/lava-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/unsub.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/predzapis.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/access.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/image-gate.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "private/**"
      }
    },
    {
      "src": "api/prodamus-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "guide/**",
      "use": "@vercel/static"
    },
    {
      "src": "guide-sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "image-sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "portfolio/**",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/**",
      "use": "@vercel/static"
    },
    {
      "src": "testi/**",
      "use": "@vercel/static"
    },
    {
      "src": "pilot-email/**",
      "use": "@vercel/static"
    },
    {
      "src": "club-email/**",
      "use": "@vercel/static"
    },
    {
      "src": "club/**",
      "use": "@vercel/static"
    },
    {
      "src": "kniga/**",
      "use": "@vercel/static"
    },
    {
      "src": "team/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/predzapis(\\.html|/)?",
      "status": 302,
      "headers": {
        "Location": "/image"
      }
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/create-payment",
      "dest": "/api/create-payment.js"
    },
    {
      "src": "/api/lava-webhook",
      "dest": "/api/lava-webhook.js"
    },
    {
      "src": "/api/unsub",
      "dest": "/api/unsub.js"
    },
    {
      "src": "/api/predzapis",
      "dest": "/api/predzapis.js"
    },
    {
      "src": "/api/prodamus-webhook",
      "dest": "/api/prodamus-webhook.js"
    },
    {
      "src": "/api/access",
      "dest": "/api/access.js"
    },
    {
      "src": "/vhod/?",
      "dest": "/vhod.html"
    },
    {
      "src": "/dostup/?",
      "dest": "/dostup.html"
    },
    {
      "src": "/imidzh-[a-z0-9]{4,}/?",
      "dest": "/podarok.html"
    },
    {
      "src": "/webinar",
      "dest": "/webinar.html"
    },
    {
      "src": "/thank-you",
      "dest": "/thank-you.html"
    },
    {
      "src": "/color-guide",
      "dest": "/guide.html"
    },
    {
      "src": "/guide/?",
      "dest": "/guide/gaidosen.html"
    },
    {
      "src": "/guide/business(\\.html|/)?",
      "dest": "/api/image-gate.js"
    },
    {
      "src": "/guide/business-razbor(\\.html)?",
      "status": 302,
      "headers": {
        "Location": "/vhod"
      }
    },
    {
      "src": "/guide/business-img/([^/]+)",
      "dest": "/api/image-gate.js?f=$1"
    },
    {
      "src": "/tariffs/?",
      "dest": "/tariffs.html"
    },
    {
      "src": "/guide/(.*)",
      "dest": "/guide/$1"
    },
    {
      "src": "/sistem-image/?",
      "dest": "/api/image-gate.js"
    },
    {
      "src": "/sistema-imidzha/?",
      "dest": "/api/image-gate.js"
    },
    {
      "src": "/image/?",
      "dest": "/guide/oplata2/index.html"
    },
    {
      "src": "/lectures",
      "dest": "/lectures.html"
    },
    {
      "src": "/consultation",
      "dest": "/consultation.html"
    },
    {
      "src": "/contacts",
      "dest": "/contacts.html"
    },
    {
      "src": "/media",
      "dest": "/media.html"
    },
    {
      "src": "/production",
      "dest": "/production.html"
    },
    {
      "src": "/switzerland",
      "dest": "/switzerland.html"
    },
    {
      "src": "/tours",
      "dest": "/tours.html"
    },
    {
      "src": "/pilot",
      "dest": "/pilot-booking.html"
    },
    {
      "src": "/mnogosloynost",
      "dest": "/mnogosloynost.html"
    },
    {
      "src": "/portfolio",
      "dest": "/portfolio.html"
    },
    {
      "src": "/portfolio/(.*)",
      "dest": "/portfolio/$1"
    },
    {
      "src": "/club/api/(.*)",
      "dest": "https://mila-bot-production-14c0.up.railway.app/club/api/$1"
    },
    {
      "src": "/kniga/?",
      "dest": "/kniga/index.html"
    },
    {
      "src": "/team/?",
      "dest": "/team/index.html"
    },
    {
      "src": "/team/(.*)",
      "dest": "/team/$1"
    },
    {
      "src": "/kniga/(.*)",
      "dest": "/kniga/$1"
    },
    {
      "src": "/club/?",
      "dest": "/club/index.html"
    },
    {
      "src": "/club/(.*)",
      "dest": "/club/$1"
    },
    {
      "src": "/ai-preview-h(\\.html)?",
      "status": 301,
      "headers": {
        "Location": "/ai"
      }
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    }
  ]
}
