{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/create-payment.js",
      "use": "@vercel/node"
    },
    {
      "src": "guide/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/gems.png",
      "dest": "/gems.png"
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/create-payment",
      "dest": "/api/create-payment.js"
    },
    {
      "src": "/thank-you",
      "dest": "/thank-you.html"
    },
    {
      "src": "/color-guide",
      "dest": "/guide.html"
    },
    {
      "src": "/guide",
      "dest": "/guide/index.html"
    },
    {
      "src": "/guide/(.*)",
      "dest": "/guide/$1"
    },
    {
      "src": "/lectures",
      "dest": "/lectures.html"
    },
    {
      "src": "/consultation",
      "dest": "/consultation.html"
    },
    {
      "src": "/contacts",
      "dest": "/contacts.html"
    },
    {
      "src": "/media",
      "dest": "/media.html"
    },
    {
      "src": "/production",
      "dest": "/production.html"
    },
    {
      "src": "/switzerland",
      "dest": "/switzerland.html"
    },
    {
      "src": "/tours",
      "dest": "/tours.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    }
  ]
}